rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep this allowlist aligned with the administrator account configured
    // in VITE_ADMIN_EMAILS. The verified token check is enforced by Firebase,
    // not by the browser UI.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'ibustechnologyltd1@gmail.com'
        ];
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && request.resource.data.uid == uid;
      allow update: if (owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'address', 'updatedAt']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.orderStatus == 'pending_payment'
        && request.resource.data.total is number
        && request.resource.data.total > 0;
      // Customers cannot mark orders paid or alter order/payment status.
      allow update, delete: if isAdmin();
    }

    match /saveToBuyPlans/{planId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.totalSaved == 0
        && request.resource.data.depositCount == 0
        && request.resource.data.deposits.size() == 0;
      // Deposits and balances are changed only by an administrator after
      // manually checking the uploaded receipt.
      allow update, delete: if isAdmin();
    }

    match /paymentSubmissions/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.receiptUrl is string
        && request.resource.data.receiptUrl.matches('https://res\\.cloudinary\\.com/.*')
        && request.resource.data.paymentType in ['order', 'save_to_buy']
        && request.resource.data.createdAt == request.time;
      // Only the verified admin can approve/reject a transfer submission.
      allow update: if isAdmin()
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.receiptUrl == resource.data.receiptUrl
        && request.resource.data.paymentType == resource.data.paymentType;
      allow delete: if isAdmin();
    }

    match /bnplApplications/{applicationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /wholesaleInquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // No collection is readable/writable by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}